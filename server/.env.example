# Copy to .env (git-ignored). On Bloxity Legion none of the first block is needed: it
# injects PORT, CLIENT_ORIGIN, MONGODB_URI, BLOXITY_GAME_ID, BLOXITY_CHANNEL, POD_NAME
# and the BLOXITY_* platform URLs.
PORT=2567
# Extra allowed browser origins, comma-separated.
CLIENT_ORIGINS=
# Leave unset locally to save to data/water.db (SQLite); set to use MongoDB instead.
# MONGODB_URI=mongodb://localhost:27017/water

# --- Boxity platform (src/bloxityEnv.js) ----------------------------------------------
# Which Boxity this server talks to. Boxity hosting injects all of these on every
# deploy; each falls back to production (src/bloxityEnv.js) only when missing, so leave
# them unset here. For a local Boxity stack, point them at it, e.g.
# BLOXITY_ENV=local and BLOXITY_API_URL=http://localhost:4000.
# Setting BLOXITY_ENV (or NODE_ENV=production) also makes the server strict about
# identity: players without a verified Boxity token are always guests.
# BLOXITY_ENV=
# BLOXITY_API_URL=
# BLOXITY_MATCHMAKER_URL=
# BLOXITY_PORTAL_URL=
# BLOXITY_STATIC_URL=
# The game's id (leaderboards) and slug (auth, ads); both default to 1-fill-water-escape.
# BLOXITY_GAME_ID=1-fill-water-escape
# BLOXITY_GAME_SLUG=1-fill-water-escape

# Token for reporting leaderboard scores (src/bloxityLeaderboards.js) and this pod's
# rooms for the game page's "Open Rooms" (src/legionRoomReporter.js, which also needs
# MATCHMAKER_REPORT_URL, injected by Boxity hosting). Unset = nothing is reported.
# MATCHMAKER_REPORT_URL=
# BLOXITY_REPORT_TOKEN=

# Shared secret Boxity sends as x-legion-webhook-secret on the Gems purchase webhook
# (POST /api/gems/webhook). Unset = the webhook accepts any caller; always set it live.
# LEGION_WEBHOOK_SECRET=
